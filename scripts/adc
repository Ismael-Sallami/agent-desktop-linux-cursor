#!/usr/bin/env python3
"""adc: an isolated Linux (X11) desktop for AI agents, with a visible agent cursor on its own workspace.

Guarantees (unless ADC_ALLOW_PHYSICAL=1):
  * never moves the real pointer, never sends physical keys/mouse, never takes focus,
    never touches the shared clipboard -> the user keeps working on another workspace;
  * windows the agent launches are moved to the agent workspace and focus is handed back;
  * the agent cursor is drawn only on the agent workspace.

Usage:
  adc start [--desktop N|new] [--name NAME]   start session + overlay (prints export line)
  adc stop                                    end session, kill overlay
  adc status                                  state + overlay ping
  adc launch APP [ARGS...]                    launch an app, move its windows to the agent desktop
  adc windows                                 X11 windows on the agent desktop
  adc adopt <xid|--app NAME>                  move an existing window to the agent desktop
Accessibility (built-in AT-SPI engine, both modes; ref actions animate the cursor):
  adc list-apps | snapshot [--app A] [--window T] [-i] [--compact]
  adc find [--app A] [--role R] [--name N] | wait ... [--gone] [--timeout ms] | get REF | is REF STATE
  adc click|right-click|focus|scroll-to|toggle|check|uncheck|expand|collapse REF
  adc type REF TEXT | set-value REF TEXT | clear REF | select REF OPTION | close-app NAME [--force]
  adc doctor                                  check dependencies (prints the apt install line)
  adc version
Nested mode (private X server on the agent workspace; physical input allowed, never reaches the user):
  adc start --nested [--size 1600x900] [--record FILE.mp4] [--desktop N]
  adc see [--scale 0.5] [--grid 100] [--region x,y,w,h] [--out F]   screenshot + coordinate grid
  adc click-xy X Y [--label T] [--mods ctrl+shift] | double-xy | right-xy | move X Y
  adc drag-xy X1 Y1 X2 Y2 | scroll-xy X Y up|down|left|right [N]
  adc key ctrl+l Return ... | write "text" [--delay ms]
  adc browser URL [--profile "Profile 1"]    Chrome inside, copy of a user profile (settings/bookmarks)
  adc run CMD ARGS...  [--real-dbus]          any app inside the nested display
  adc record start [FILE] | record stop
  adc browser URL [--name linkedin]          persistent agent browser profile (log in once)
  adc ask-user "Please sign in to LinkedIn" [--title T] [--timeout s]   system notification, user hands off
  adc key/write ... [--target "window title"] -> data.focused = window that received the input
Extra flags: --label "text" / --adc-label "text"   label shown on the agent cursor for this action
Env: ADC_AGENT (cursor id / colour), ADC_ALLOW_PHYSICAL=1 to lift the shared-mode policy
     (only with the user's explicit OK), ADC_LANG (en|es) for hand-off notifications.
"""
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
try:
    import adc_pro as PRO  # optional Pro plugin (scripts/adc_pro.py)
except ImportError:
    PRO = None

VERSION = "2.0.0"
BASE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/adc-{os.getuid()}"), "adc")
SESSION = re.sub(r"[^\w.-]", "_", os.environ.get("ADC_SESSION", "default")) or "default"
RUN = BASE if SESSION == "default" else os.path.join(BASE, "sessions", SESSION)
STATE = os.path.join(RUN, "state.json")
ENGINE = os.path.join(HERE, "adc_a11y.py")
REF_RE = re.compile(r"^@[A-Za-z0-9]+:e\d+$")

ENGINE_CMDS = {"list-apps", "snapshot", "find", "wait", "get", "is", "click", "right-click", "focus",
               "scroll-to", "toggle", "check", "uncheck", "expand", "collapse", "type", "set-value",
               "clear", "select", "close-app"}
REF_ACTIONS = {"click", "right-click", "type", "set-value", "clear", "select", "toggle", "check",
               "uncheck", "expand", "collapse", "scroll-to", "focus"}
TYPE_ACTIONS = {"type", "set-value", "clear"}


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


def fail(code, msg, suggestion=None, cmd="adc"):
    err = {"code": code, "message": msg, "disposition": {"delivery": "not_delivered", "retry": "safe"}}
    if suggestion:
        err["suggestion"] = suggestion
    out({"ok": False, "command": cmd, "error": err})
    sys.exit(1)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_state(st):
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(st, f)


def sh(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def root_prop(name):
    o = sh(["xprop", "-root", name]).stdout.strip()
    # "NAME(CARDINAL) = 1"  or  "NAME(WINDOW): window id # 0x1, 0x2"
    m = re.match(r"^[^(]*\([^)]*\)\s*(?:=|:)\s*(.*)$", o, re.S)
    return m.group(1).strip() if m else ""


def current_desktop():
    try:
        return int(root_prop("_NET_CURRENT_DESKTOP"))
    except ValueError:
        return 0


def num_desktops():
    try:
        return int(root_prop("_NET_NUMBER_OF_DESKTOPS"))
    except ValueError:
        return 1


def client_list():
    v = root_prop("_NET_CLIENT_LIST")
    return [int(x, 16) for x in re.findall(r"0x[0-9a-fA-F]+", v)]


def active_window():
    m = re.search(r"0x[0-9a-fA-F]+", root_prop("_NET_ACTIVE_WINDOW"))
    return int(m.group(0), 16) if m else 0


def win_desktop(xid):
    o = sh(["xprop", "-id", hex(xid), "_NET_WM_DESKTOP"]).stdout
    m = re.search(r"=\s*(-?\d+)", o)
    return int(m.group(1)) if m else None


def win_info(xid):
    o = sh(["xprop", "-id", hex(xid), "_NET_WM_PID", "WM_CLASS", "_NET_WM_NAME", "_NET_WM_DESKTOP"]).stdout
    info = {"xid": hex(xid)}
    for line in o.splitlines():
        if line.startswith("_NET_WM_PID"):
            info["pid"] = int(line.split("=")[1])
        elif line.startswith("WM_CLASS"):
            info["class"] = re.findall(r'"([^"]*)"', line)
        elif line.startswith("_NET_WM_NAME"):
            m = re.search(r'"(.*)"', line)
            info["title"] = m.group(1) if m else ""
        elif line.startswith("_NET_WM_DESKTOP"):
            info["desktop"] = int(line.split("=")[1])
    return info


def x11_startup_message(msg):
    """Broadcast a startup-notification message (freedesktop startup-notification spec).

    Mutter reads DESKTOP= from the "new:" message and maps the app's first window directly
    on that workspace; a stale TIMESTAMP keeps focus-stealing prevention from activating it.
    """
    import ctypes as C
    x = C.CDLL("libX11.so.6")
    x.XOpenDisplay.restype = C.c_void_p
    x.XOpenDisplay.argtypes = [C.c_char_p]
    x.XDefaultRootWindow.restype = C.c_ulong
    x.XDefaultRootWindow.argtypes = [C.c_void_p]
    x.XCreateSimpleWindow.restype = C.c_ulong
    x.XCreateSimpleWindow.argtypes = [C.c_void_p, C.c_ulong, C.c_int, C.c_int, C.c_uint, C.c_uint,
                                      C.c_uint, C.c_ulong, C.c_ulong]
    x.XInternAtom.restype = C.c_ulong
    x.XInternAtom.argtypes = [C.c_void_p, C.c_char_p, C.c_int]
    x.XSendEvent.argtypes = [C.c_void_p, C.c_ulong, C.c_int, C.c_long, C.c_void_p]
    x.XDestroyWindow.argtypes = [C.c_void_p, C.c_ulong]
    x.XFlush.argtypes = [C.c_void_p]
    x.XSync.argtypes = [C.c_void_p, C.c_int]
    x.XCloseDisplay.argtypes = [C.c_void_p]

    class XClientData(C.Union):  # union { char b[20]; short s[10]; long l[5]; } -> long-aligned
        _fields_ = [("b", C.c_char * 20), ("l", C.c_long * 5)]

    class XClientMessageEvent(C.Structure):
        _fields_ = [("type", C.c_int), ("serial", C.c_ulong), ("send_event", C.c_int),
                    ("display", C.c_void_p), ("window", C.c_ulong), ("message_type", C.c_ulong),
                    ("format", C.c_int), ("data", XClientData)]

    class XEvent(C.Union):
        _fields_ = [("xclient", XClientMessageEvent), ("pad", C.c_long * 24)]

    dpy = x.XOpenDisplay(None)
    if not dpy:
        return False
    root = x.XDefaultRootWindow(dpy)
    win = x.XCreateSimpleWindow(dpy, root, -100, -100, 1, 1, 0, 0, 0)
    begin = x.XInternAtom(dpy, b"_NET_STARTUP_INFO_BEGIN", 0)
    more = x.XInternAtom(dpy, b"_NET_STARTUP_INFO", 0)
    data = msg.encode() + b"\0"
    for i in range(0, len(data), 20):
        ev = XEvent()
        ev.xclient.type = 33  # ClientMessage
        ev.xclient.send_event = 1
        ev.xclient.display = dpy
        ev.xclient.window = win
        ev.xclient.message_type = begin if i == 0 else more
        ev.xclient.format = 8
        C.memmove(C.addressof(ev.xclient.data), data[i:i + 20].ljust(20, b"\0"), 20)
        x.XSendEvent(dpy, root, 0, 1 << 22, C.byref(ev))  # PropertyChangeMask
    x.XSync(dpy, 0)
    x.XDestroyWindow(dpy, win)
    x.XCloseDisplay(dpy)
    return True


def sn_quote(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def move_to_desktop(xid, n):
    sh(["xdotool", "set_desktop_for_window", str(xid), str(n)])


def overlay(req, st=None):
    st = st or load_state()
    if not st:
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect(st["socket"])
        s.sendall((json.dumps(req) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
        s.close()
        return json.loads(data or b"null")
    except (OSError, ValueError):
        return None


def engine_env(st):
    env = dict(os.environ)
    if st and st.get("mode") == "nested":
        import adc_nested as N
        env = N.nenv(st)
    env["ADC_STATE_DIR"] = RUN
    return env


def eng(args, st=None, timeout=120):
    """Run the accessibility engine against the session's display; returns the parsed JSON."""
    st = st or load_state()
    try:
        r = subprocess.run([sys.executable, "-I", ENGINE] + list(args), capture_output=True, text=True,
                           env=engine_env(st), timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"ok": False, "command": args[0] if args else "", "error": {"code": "TIMEOUT",
                "message": "accessibility engine timed out (application not responding)"}}
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {"ok": False, "command": args[0] if args else "",
                "error": {"code": "INTERNAL", "message": (r.stderr or r.stdout).strip()[-800:]}}


# ---------------------------------------------------------------- commands
def cmd_start(argv):
    old = load_state()
    if old and overlay({"op": "ping"}, old):
        fail("ADC_ALREADY_RUNNING", f"adc session {SESSION!r} already running ({old['session']})",
             "reuse it, run `adc stop` first" + (", or set ADC_SESSION=<name> for a parallel one" if PRO else ""),
             "start")
    want, name, nested, size, record = "new", None, False, "1600x900", None
    i = 0
    while i < len(argv):
        if argv[i] == "--nested":
            nested = True
            i += 1
        elif argv[i] == "--size":
            size = argv[i + 1]
            i += 2
        elif argv[i] == "--record":
            record = argv[i + 1]
            i += 2
        elif argv[i] == "--desktop":
            want = argv[i + 1]
            i += 2
        elif argv[i] == "--name":
            name = argv[i + 1]
            i += 2
        else:
            fail("INVALID_ARGS", f"unknown arg {argv[i]}", cmd="start")
    cur = current_desktop()
    if want == "new":
        # Dynamic GNOME workspaces keep one empty workspace at the end; use it.
        desk = num_desktops() - 1
        if desk == cur:
            desk = cur + 1  # moving a window there makes GNOME create it
    else:
        desk = int(want)
    if desk == cur:
        print(json.dumps({"warning": "agent desktop equals the user's current desktop"}), file=sys.stderr)
    if SESSION != "default" and not PRO:
        fail("ADC_PRO_FEATURE", "parallel named sessions (ADC_SESSION) are part of adc Pro",
             "unset ADC_SESSION to use the single default session", "start")
    import secrets
    sid = (re.sub(r"[^\w-]", "", name or "") or "adc") + "-" + secrets.token_hex(3)
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    try:
        os.unlink(os.path.join(RUN, "refs.json"))
    except OSError:
        pass
    sock = os.path.join(RUN, f"{sid}.sock")
    log = open(os.path.join(RUN, "overlay.log"), "a")
    if nested:
        import adc_nested as N
        try:
            st = N.start(RUN, sid, desk, size, record, os.path.join(HERE, "adc-overlay.py"), log)
        except Exception as e:  # noqa: BLE001
            fail("ADC_NESTED_FAILED", str(e), "see $XDG_RUNTIME_DIR/adc/overlay.log", "start")
        st.update({"session": sid, "desktop": desk, "pid": st["pids"]["overlay"], "user_desktop": cur,
                   "started": time.time(), "name": SESSION})
        save_state(st)
        for _ in range(50):
            if overlay({"op": "ping"}, st):
                break
            time.sleep(0.1)
        data = {"session_id": sid, "mode": "nested", "display": st["display"], "size": st["size"],
                "agent_desktop": desk, "user_desktop": cur, "window_manager": st["wm"],
                "a11y_bus": bool(st["a11y_bus"]), "overlay": bool(overlay({"op": "ping"}, st)),
                "recording": st.get("recording"), "adc_session": SESSION, "pro": bool(PRO)}
        if not st["wm"]:
            data["warning"] = "no window manager (sudo apt install openbox): windows cannot be focused or closed gracefully"
        out({"ok": True, "command": "adc start", "data": data})
        return
    p = subprocess.Popen([sys.executable, "-I", os.path.join(HERE, "adc-overlay.py"),
                          "--socket", sock, "--desktop", str(desk)],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    st = {"session": sid, "desktop": desk, "socket": sock, "pid": p.pid, "user_desktop": cur, "mode": "shared",
          "started": time.time(), "name": SESSION}
    save_state(st)
    for _ in range(50):
        if overlay({"op": "ping"}, st):
            break
        time.sleep(0.1)
    ok = bool(overlay({"op": "ping"}, st))
    out({"ok": True, "command": "adc start",
         "data": {"session_id": sid, "mode": "shared", "agent_desktop": desk, "user_desktop": cur, "overlay": ok,
                  "adc_session": SESSION, "pro": bool(PRO)}})


def cmd_stop(argv):
    st = load_state()
    if not st:
        out({"ok": True, "command": "adc stop", "data": {"stopped": False}})
        return
    overlay({"op": "quit"}, st)
    time.sleep(0.3)
    rec = None
    if st.get("mode") == "nested":
        import adc_nested as N
        rec = st.get("recording")
        # close every nested app like a person (window close button) so browsers save cookies
        try:
            for a in eng(["list-apps"], st, timeout=20)["data"]["apps"]:
                if a.get("presentation") != "background":
                    eng(["close-app", a["name"], "--timeout", "6"], st, timeout=30)
        except (KeyError, TypeError):
            pass
        N.stop(st)
    try:
        os.kill(st["pid"], signal.SIGTERM)
    except OSError:
        pass
    if PRO and hasattr(PRO, "on_stop"):
        PRO.on_stop(sys.modules[__name__], st)
    if rec:
        print(json.dumps({"recording_saved": rec}), file=sys.stderr)
    try:
        os.unlink(STATE)
    except OSError:
        pass
    out({"ok": True, "command": "adc stop", "data": {"session_id": st["session"], "recording": rec}})


def cmd_status(argv):
    st = load_state()
    out({"ok": True, "command": "adc status",
         "data": {"state": st, "overlay": overlay({"op": "ping"}, st) if st else None,
                  "current_desktop": current_desktop(), "desktops": num_desktops()}})


def cmd_windows(argv):
    st = load_state() or fail("ADC_NO_SESSION", "run `adc start` first", cmd="windows")
    wins = [win_info(x) for x in client_list()]
    out({"ok": True, "command": "adc windows",
         "data": {"agent_desktop": st["desktop"], "windows": [w for w in wins if w.get("desktop") == st["desktop"]]}})


def cmd_adopt(argv):
    st = load_state() or fail("ADC_NO_SESSION", "run `adc start` first", cmd="adopt")
    xids = []
    if argv[:1] == ["--app"] and len(argv) > 1:
        needle = argv[1].lower()
        for x in client_list():
            w = win_info(x)
            if any(needle in c.lower() for c in w.get("class", [])):
                xids.append(x)
    elif argv:
        xids = [int(argv[0], 0)]
    if not xids:
        fail("WINDOW_NOT_FOUND", "no matching X11 window", cmd="adopt")
    for x in xids:
        move_to_desktop(x, st["desktop"])
    out({"ok": True, "command": "adc adopt", "data": {"moved": [hex(x) for x in xids], "agent_desktop": st["desktop"]}})


def cmd_launch(argv):
    st = load_state() or fail("ADC_NO_SESSION", "run `adc start` first", cmd="launch")
    if not argv:
        fail("INVALID_ARGS", "launch needs an application", cmd="launch")
    if st.get("mode") == "nested":  # same as `adc run` on the private display
        return cmd_human("run", argv)
    overlay({"op": "busy", "ms": 15000}, st)
    before = set(client_list())
    user_active = active_window()
    app = os.path.basename(argv[0])
    sid = f"adc-{os.getpid()}-{int(time.time() * 1000)}_TIME1"  # _TIME1 = ancient user time -> no focus
    sn_ok = False
    try:
        sn_ok = x11_startup_message(
            f"new: ID={sn_quote(sid)} NAME={sn_quote(app)} SCREEN=0 DESKTOP={st['desktop']} "
            f"BIN={sn_quote(app)} TIMESTAMP=1")
    except OSError:
        sn_ok = False
    env = dict(os.environ, GTK_MODULES="gail:atk-bridge", NO_AT_BRIDGE="0", ACCESSIBILITY_ENABLED="1",
               QT_LINUX_ACCESSIBILITY_ALWAYS_ON="1")
    if sn_ok:
        env["DESKTOP_STARTUP_ID"] = sid
    try:
        proc = subprocess.Popen(argv, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        fail("LAUNCH_FAILED", str(e), cmd="launch")
    st.setdefault("apps", []).append(proc.pid)
    save_state(st)
    moved, deadline, first_seen, appeared_elsewhere = [], time.time() + 12, None, []
    # Poll fast so the new window spends as little time as possible on the user's desktop.
    while time.time() < deadline:
        new = [x for x in client_list() if x not in before and x not in moved]
        for x in new:
            d = win_desktop(x)
            if d is not None and d != st["desktop"] and d != 0xFFFFFFFF:
                appeared_elsewhere.append(hex(x))
            move_to_desktop(x, st["desktop"])
            moved.append(x)
            first_seen = first_seen or time.time()
        if first_seen and time.time() - first_seen > 1.5:
            break  # give the app 1.5 s for extra (splash/main) windows
        time.sleep(0.05)
    if sn_ok:
        try:
            x11_startup_message(f"remove: ID={sn_quote(sid)}")
        except OSError:
            pass
    restored = False
    if moved and user_active and active_window() in moved + [0]:
        sh(["xdotool", "windowactivate", str(user_active)])
        restored = True
    data = {"pid": proc.pid, "agent_desktop": st["desktop"], "moved_windows": [win_info(x) for x in moved],
            "user_focus_restored": restored, "startup_notification": sn_ok,
            "mapped_on_other_desktop_first": appeared_elsewhere}
    if not moved:
        data["note"] = ("no new X11 window: app may be attached to an existing instance or is "
                        "Wayland-native; use `adc adopt --app <class>` if its window sits on the user's desktop")
    out({"ok": True, "command": "adc launch", "data": data})


def _on_screen(rect, st):
    if not rect:
        return False
    w, h = st.get("size") or (10 ** 5, 10 ** 5)
    cx, cy = rect[0] + rect[2] / 2, rect[1] + rect[3] / 2
    return 0 <= cx < w and 0 <= cy < h


def _center(rect):
    return rect[0] + rect[2] / 2, rect[1] + rect[3] / 2


def _pop_label(argv):
    label = None
    for flag in ("--adc-label", "--label"):
        if flag in argv:
            i = argv.index(flag)
            label = argv[i + 1] if i + 1 < len(argv) else None
            argv = argv[:i] + argv[i + 2:]
    return argv, label


def accessibility(argv):
    """Built-in AT-SPI engine. Nested mode moves the real pointer onto the element first and types
    with the real keyboard (so web pages receive genuine input events); shared mode stays headless."""
    st = load_state()
    argv, label = _pop_label(argv)
    cmd = argv[0]
    nested = bool(st and st.get("mode") == "nested")
    agent = os.environ.get("ADC_AGENT") or "agent"
    if PRO and hasattr(PRO, "before"):
        argv = PRO.before(sys.modules[__name__], cmd, argv, st) or argv
    ref = next((a for a in argv[1:] if REF_RE.match(a)), None)
    if st and cmd in ("snapshot", "find", "get", "is", "wait", "list-apps"):
        overlay({"op": "think", "agent": agent, "ms": 1200}, st)
    rect = None
    if st and ref and cmd in REF_ACTIONS:
        g = eng(["get", ref, "--property", "bounds"], st)
        if not g.get("ok"):
            out(g)
            sys.exit(1)
        rect = (g.get("data") or {}).get("bounds")
        if nested and rect and cmd != "scroll-to" and not _on_screen(rect, st):
            s = eng(["scroll-to", ref], st)  # bring off-screen elements into view first
            rect = (s.get("data") or {}).get("bounds") if s.get("ok") else rect
            if not _on_screen(rect, st):
                rect = None
        if rect and rect[2] > 0 and rect[3] > 0 and (not nested or _on_screen(rect, st)):
            cx, cy = _center(rect)
            if nested:
                import adc_nested as N
                N.glide(st, lambda q: overlay(q, st), cx, cy, label or f"{agent}: {cmd}", agent)
            else:
                resp = overlay({"op": "move", "agent": agent, "x": cx, "y": cy,
                                "label": label or f"{agent}: {cmd}"}, st)
                if resp and resp.get("ms"):
                    time.sleep(resp["ms"] / 1000 + 0.04)
        else:
            rect = None
    if st and not nested:
        overlay({"op": "busy", "ms": 4000}, st)
    if nested and rect and cmd in TYPE_ACTIONS:
        res = _nested_type(st, cmd, argv, rect, agent)
    else:
        res = eng(argv, st)
        if nested and rect and not res.get("ok") and res.get("error", {}).get("code") == "ACTION_UNSUPPORTED" \
                and cmd in ("click", "right-click", "focus", "toggle", "check", "uncheck", "expand", "collapse"):
            import adc_nested as N
            cx, cy = _center(rect)
            N.click(st, lambda q: overlay(q, st), int(cx), int(cy), 3 if cmd == "right-click" else 1, 1,
                    None, agent)
            res = {"ok": True, "command": cmd, "data": {"action": "physical-click", "bounds": rect}}
    if nested and cmd == "select" and res.get("ok") and (res.get("data") or {}).get("popup_open"):
        import adc_nested as N
        N.key(st, lambda q: overlay(q, st), "Escape")  # a dropdown left open keeps the keyboard grabbed
        res["data"]["popup_open"] = False
    if st and rect and res.get("ok"):
        cx, cy = _center(rect)
        overlay({"op": "type" if cmd in TYPE_ACTIONS else "click", "agent": agent, "x": cx, "y": cy,
                 "rect": rect}, st)
    if PRO and hasattr(PRO, "after"):
        PRO.after(sys.modules[__name__], cmd, argv, st, res)
    out(res)
    sys.exit(0 if res.get("ok") else 1)


def _nested_type(st, cmd, argv, rect, agent):
    """Real keyboard input into an element of the private display: click it, optionally select all
    and delete, then type. Reads the text back through accessibility when possible."""
    import adc_nested as N
    ov = lambda q: overlay(q, st)  # noqa: E731
    text = " ".join(a for a in argv[2:]) if cmd != "clear" else ""
    cx, cy = _center(rect)
    focused = eng(["focus", argv[1]], st)
    if not (focused.get("ok") and focused["data"].get("focused")):
        N.click(st, ov, int(cx), int(cy), 1, 1, None, agent)
    time.sleep(0.1)
    if cmd in ("set-value", "clear"):
        N.key(st, ov, "ctrl+a")
        N.key(st, ov, "BackSpace")
    else:
        N.key(st, ov, "End")
    if text:
        N.write(st, ov, text, None, agent)
    time.sleep(0.15)
    g = eng(["get", argv[1], "--property", "text"], st)
    data = {"typed": text, "bounds": rect, "via": "keyboard"}
    if g.get("ok"):
        data["text"] = g["data"].get("text")
    return {"ok": True, "command": cmd, "data": data}


# ---------------------------------------------------------------- nested "human" commands
HUMAN = {"see", "click-xy", "double-xy", "right-xy", "move", "drag-xy", "key", "write", "scroll-xy",
         "browser", "run", "record", "wait-idle", "ask-user", "focus"}


def _opts(argv, flags):
    """tiny parser: returns (positional, {flag: value}); flags map name->takes_value"""
    pos, kv, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in flags:
            if flags[a]:
                kv[a] = argv[i + 1]
                i += 2
            else:
                kv[a] = True
                i += 1
        else:
            pos.append(a)
            i += 1
    return pos, kv


def videos_dir():
    try:
        d = subprocess.run(["xdg-user-dir", "VIDEOS"], capture_output=True, text=True).stdout.strip()
    except OSError:
        d = ""
    return d or os.path.expanduser("~/Videos")


def cmd_human(name, argv):
    st = load_state()
    if not st or st.get("mode") != "nested":
        fail("ADC_NOT_NESTED", f"`{name}` needs a nested session", "adc start --nested", name)
    import adc_nested as N
    ov = lambda q: overlay(q, st)  # noqa: E731
    agent = os.environ.get("ADC_AGENT") or "agent"
    pos, kv = _opts(argv, {"--label": True, "--out": True, "--scale": True, "--grid": True, "--region": True,
                           "--profile": True, "--mods": True, "--delay": True, "--real-dbus": False,
                           "--target": True, "--name": True, "--title": True, "--timeout": True})
    label = kv.get("--label")
    data = {}
    if PRO and hasattr(PRO, "before"):
        new = PRO.before(sys.modules[__name__], name, [name] + argv, st)
        if new:
            pos, kv = _opts(new[1:], {"--label": True, "--out": True, "--scale": True, "--grid": True,
                                      "--region": True, "--profile": True, "--mods": True, "--delay": True,
                                      "--real-dbus": False, "--target": True, "--name": True, "--title": True,
                                      "--timeout": True})
    try:
        if name == "see":
            outp = kv.get("--out") or os.path.join(RUN, f"see-{int(time.time() * 1000)}.png")
            region = [int(v) for v in kv["--region"].split(",")] if "--region" in kv else None
            data = N.see(st, outp, float(kv.get("--scale", 0.5)), int(kv.get("--grid", 100)), region)
        elif name in ("click-xy", "double-xy", "right-xy"):
            x, y = int(float(pos[0])), int(float(pos[1]))
            mods = kv["--mods"].split("+") if "--mods" in kv else ()
            N.click(st, ov, x, y, 3 if name == "right-xy" else 1, 2 if name == "double-xy" else 1,
                    label, agent, mods)
            data = {"x": x, "y": y}
        elif name == "move":
            N.glide(st, ov, int(float(pos[0])), int(float(pos[1])), label, agent)
        elif name == "drag-xy":
            x1, y1, x2, y2 = (int(float(v)) for v in pos[:4])
            N.drag(st, ov, x1, y1, x2, y2, label, agent)
        elif name == "key":
            data["focused"] = N.focus(st, kv.get("--target"))
            for combo in pos:
                N.key(st, ov, combo, label, agent)
        elif name == "write":
            data["focused"] = N.focus(st, kv.get("--target"))
            N.write(st, ov, " ".join(pos), label, agent, int(kv.get("--delay", 45)))
        elif name == "focus":
            data["focused"] = N.focus(st, pos[0] if pos else kv.get("--target"))
        elif name == "ask-user":
            data = N.ask_user(st, ov, " ".join(pos) or "Please sign in so the agent can continue.",
                              kv.get("--title"), int(kv.get("--timeout", 900)))
        elif name == "scroll-xy":
            N.scroll(st, ov, int(float(pos[0])), int(float(pos[1])), pos[2], int(pos[3]) if len(pos) > 3 else 3, agent)
        elif name == "browser":
            log = open(os.path.join(RUN, "apps.log"), "a")
            pid, udd = N.browser(st, RUN, pos[0] if pos else "about:blank", kv.get("--profile"), log,
                                 kv.get("--name"))
            save_state(st)
            data = {"pid": pid, "user_data_dir": udd, "app_name_hint": "chrome"}
        elif name == "run":
            log = open(os.path.join(RUN, "apps.log"), "a")
            pid = N.launch(st, pos, log, real_dbus=bool(kv.get("--real-dbus")))
            save_state(st)
            data = {"pid": pid}
        elif name == "record":
            if pos[:1] == ["start"]:
                data = N.record_start(st, pos[1] if len(pos) > 1 else os.path.expanduser(
                    videos_dir() + f"/adc-{time.strftime('%Y%m%d-%H%M%S')}.mp4"), open(os.path.join(RUN, "overlay.log"), "a"))
            else:
                data = N.record_stop(st)
            save_state(st)
        elif name == "wait-idle":
            time.sleep(float(pos[0]) / 1000 if pos else 0.5)
    except (IndexError, ValueError) as e:
        fail("INVALID_ARGS", f"{name}: {e}", "adc --help", name)
    except Exception as e:  # noqa: BLE001
        fail("ACTION_FAILED", f"{name}: {e}", cmd=name)
    res = {"ok": True, "command": f"adc {name}", "data": data}
    if PRO and hasattr(PRO, "after"):
        PRO.after(sys.modules[__name__], name, [name] + argv, st, res)
    out(res)


DEPS = [  # (binary, apt package, needed for)
    ("Xephyr", "xserver-xephyr", "nested mode"), ("openbox", "openbox", "nested window manager"),
    ("picom", "picom", "agent cursor transparency"), ("xdotool", "xdotool", "input and windows"),
    ("xprop", "x11-utils", "workspace control"), ("xdpyinfo", "x11-utils", "display checks"),
    ("xsetroot", "x11-xserver-utils", "nested background"), ("setxkbmap", "x11-xkb-utils", "keyboard layout"),
    ("wmctrl", "wmctrl", "graceful window close"), ("xclip", "xclip", "unicode typing"),
    ("import", "imagemagick", "screenshots"), ("convert", "imagemagick", "screenshot grid"),
    ("ffmpeg", "ffmpeg", "recording"), ("notify-send", "libnotify-bin", "ask-user hand-off"),
    ("dbus-daemon", "dbus", "private session bus"), ("dbus-send", "dbus", "accessibility bus"),
]


def cmd_doctor(argv):
    import shutil
    missing, checks = [], []
    for b, pkg, why in DEPS:
        ok = bool(shutil.which(b))
        checks.append({"binary": b, "ok": ok, "for": why})
        if not ok and pkg not in missing:
            missing.append(pkg)
    chrome = shutil.which("google-chrome") or shutil.which("chromium") or shutil.which("chromium-browser")
    r = subprocess.run([sys.executable, "-I", "-c", "import gi;gi.require_version('Atspi','2.0');"
                        "gi.require_version('Gtk','3.0');from gi.repository import Atspi,Gtk"],
                       capture_output=True, text=True)
    gi_ok = r.returncode == 0
    if not gi_ok:
        missing += ["python3-gi", "gir1.2-atspi-2.0", "gir1.2-gtk-3.0"]
    session = os.environ.get("XDG_SESSION_TYPE", "unknown")
    data = {"version": VERSION, "pro": bool(PRO), "x11": session == "x11" and bool(os.environ.get("DISPLAY")),
            "session_type": session, "python_gi_atspi_gtk": gi_ok, "browser": chrome, "checks": checks,
            "missing_packages": missing}
    if missing:
        data["install"] = "sudo apt install " + " ".join(missing)
    if session != "x11":
        data["warning"] = "adc needs an X11 session (log in with 'Ubuntu on Xorg')"
    if PRO and hasattr(PRO, "doctor"):
        data["pro_checks"] = PRO.doctor(sys.modules[__name__])
    out({"ok": not missing and data["x11"], "command": "adc doctor", "data": data})


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if os.environ.get("XDG_SESSION_TYPE", "x11") != "x11" or not os.environ.get("DISPLAY"):
        if argv[0] in ("start", "launch", "adopt", "windows"):
            fail("PLATFORM_NOT_SUPPORTED", "adc workspace isolation and overlay need an X11 session", cmd=argv[0])
    table = {"start": cmd_start, "stop": cmd_stop, "status": cmd_status, "windows": cmd_windows,
             "adopt": cmd_adopt, "doctor": cmd_doctor}
    if argv[0] in ("version", "--version"):
        return out({"ok": True, "command": "adc version", "data": {"version": VERSION, "pro": bool(PRO),
                    "pro_version": getattr(PRO, "VERSION", None)}})
    if argv[0] == "launch":
        return cmd_launch(argv[1:])
    if argv[0] in table:
        return table[argv[0]](argv[1:])
    if PRO and argv[0] in getattr(PRO, "COMMANDS", {}):
        return PRO.COMMANDS[argv[0]](sys.modules[__name__], argv[1:])
    if argv[0] == "focus" and any(REF_RE.match(a) for a in argv[1:]):
        return _shared_policy(argv) or accessibility(argv)
    if argv[0] in HUMAN:
        return cmd_human(argv[0], argv[1:])
    if argv[0] in ENGINE_CMDS:
        return _shared_policy(argv) or accessibility(argv)
    hint = "adc --help"
    if PRO is None and argv[0] in PRO_ONLY:
        fail("ADC_PRO_FEATURE", f"`{argv[0]}` is part of adc Pro", "https://www.agensi.io (adc Pro)", argv[0])
    fail("UNKNOWN_COMMAND", f"unknown command {argv[0]!r}", hint, argv[0])


# Commands of the Pro plugin, listed so the free edition can say where they come from.
PRO_ONLY = {"marks", "click-mark", "find-text", "click-text", "wait-text", "wait-stable", "wait-change", "macro",
            "journal", "report", "gif", "mcp", "guard", "clip", "downloads", "sessions", "type-mark"}


def _shared_policy(argv):
    """Shared mode lives on the user's X server: refuse what would move the user's focus."""
    st = load_state()
    if st and st.get("mode") != "nested" and os.environ.get("ADC_ALLOW_PHYSICAL") != "1" and argv[0] == "focus":
        fail("ADC_POLICY", "`focus` would move the user's keyboard focus in shared mode",
             "use click/type/set-value (headless), or ask the user before setting ADC_ALLOW_PHYSICAL=1", "focus")
    return None


if __name__ == "__main__":
    main()
